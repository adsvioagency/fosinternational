---
// The site's front door: one real, indexable page at "/" that belongs to no single language.
// It used to be a redirect (302 to /fr/, /en/ or /es/ by Accept-Language), which left the bare
// domain uncrawlable and had Google file three homepage URLs as redirects. Now it answers 200 to
// everyone — whatever their browser language or nf_lang cookie — and simply offers the three
// versions. Being language-neutral, it is the homepage cluster's hreflang x-default.
import '../styles/global.css';
import { Image, getImage } from 'astro:assets';
import Icon from '../components/Icon.astro';
import emblem from '../assets/photos/logo-emblem.png';
import logo from '../assets/photos/logo-official.jpg';
import portrait from '../assets/photos/fernando-portrait-blue.jpg';
import { business, addressLine, directionsUrl } from '../config/business';
import { isLaunchBuild } from '../config/env';
import { langs } from '../content/types';
import { alternatesFor, pathFor, rootPath, xDefaultFor } from '../i18n/routes';
import { langNames, ui } from '../i18n/ui';
import { abs, jsonLd, organizationNode, websiteNode } from '../lib/seo';

const canonical = abs(rootPath);
const alternates = alternatesFor('home');
const title = `${business.name} (${business.acronym})`;
const description =
  'Fernando OMG Services (FOS) : consultation, préparation de documents et interprétation en immigration. Choisissez votre langue — français, English, Español.';

// Each language introduces itself in its own words, reusing that version's own strapline.
const choices = langs.map((l) => ({
  lang: l,
  name: langNames[l].name,
  href: pathFor('home', l),
  eyebrow: ui[l].home.eyebrow,
}));

const logoImg = await getImage({ src: logo, width: 512, format: 'jpg' });
const portraitImg = await getImage({ src: portrait, width: 800, format: 'jpg' });
const graph = [organizationNode('fr', abs(logoImg.src), abs(portraitImg.src)), websiteNode()];
---

<!doctype html>
<html lang="fr" translate="no">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google" content="notranslate" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!isLaunchBuild && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={abs(alternates[l])} />)}
    <link rel="alternate" hreflang="x-default" href={abs(xDefaultFor('home'))} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={abs('/og-default.jpg')} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={business.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#00295F" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script type="application/ld+json" set:html={jsonLd(graph)} />
  </head>
  <body>
    <main class="gate">
      <div class="gate__card">
        <Image
          class="gate__logo"
          src={emblem}
          alt=""
          width={72}
          height={Math.round((72 * emblem.height) / emblem.width)}
          densities={[2, 3]}
          loading="eager"
        />
        <h1>
          {business.name}
          <span class="gate__acronym">({business.acronym})</span>
        </h1>

        <ul class="gate__langs" role="list">
          {
            choices.map((c) => (
              <li>
                <a href={c.href} hreflang={c.lang} lang={c.lang}>
                  <span class="gate__lang">{c.name}</span>
                  <span class="gate__eyebrow">{c.eyebrow}</span>
                  <Icon name="arrowRight" size={20} />
                </a>
              </li>
            ))
          }
        </ul>

        <ul class="gate__facts" role="list">
          <li>
            <Icon name="phone" size={18} />
            <a href={business.phone.tel}>{business.phone.display}</a>
          </li>
          <li>
            <Icon name="whatsapp" size={18} />
            <a href={business.whatsapp.base} rel="noopener" target="_blank">WhatsApp</a>
          </li>
          <li>
            <Icon name="mail" size={18} />
            <a href={`mailto:${business.email}`}>{business.email}</a>
          </li>
          <li>
            <Icon name="mapPin" size={18} />
            <a href={directionsUrl()} rel="noopener" target="_blank">{addressLine('es')}</a>
          </li>
        </ul>
      </div>
    </main>

    <script is:inline>
      // No redirect: everyone sees this page. The visitor's own language is only marked as a hint,
      // so the markup Google crawls is identical for every visitor.
      (function () {
        var supported = { fr: 1, en: 1, es: 1 };
        var cookie = document.cookie.match(/(?:^|;\s*)nf_lang=(fr|en|es)/);
        var pick = cookie ? cookie[1] : null;
        if (!pick) {
          var prefs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || ''];
          for (var i = 0; i < prefs.length && !pick; i++) {
            var base = String(prefs[i]).toLowerCase().split('-')[0];
            // Haitian Creole readers are offered French.
            if (base === 'ht') base = 'fr';
            if (supported[base]) pick = base;
          }
        }
        var link = pick && document.querySelector('.gate__langs a[hreflang="' + pick + '"]');
        if (link) link.parentElement.classList.add('is-suggested');
      })();
    </script>
  </body>
</html>

<style>
  .gate {
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: clamp(1.5rem, 1rem + 3vw, 4rem) var(--gutter);
    background: var(--warm);
  }
  .gate__card {
    width: 100%;
    max-width: 34rem;
    padding: clamp(1.75rem, 1.2rem + 2.5vw, 3rem);
    border-radius: var(--radius-lg);
    background: var(--white);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    text-align: center;
  }
  .gate__logo {
    width: 72px;
    height: auto;
    margin-bottom: 1.1rem;
  }
  .gate h1 {
    margin: 0 0 1.75rem;
    font-size: var(--step-3);
    line-height: 1.15;
    color: var(--navy);
    text-wrap: balance;
  }
  .gate__acronym {
    display: block;
    margin-top: 0.25rem;
    font-size: var(--step-1);
    font-weight: 700;
    color: var(--muted);
  }
  .gate__langs {
    list-style: none;
    margin: 0 0 1.75rem;
    padding: 0;
    display: grid;
    gap: 0.75rem;
    text-align: left;
  }
  .gate__langs a {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0 1rem;
    min-height: 56px;
    padding: 0.75rem 1.1rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--white);
    color: var(--navy);
    text-decoration: none;
    transition: border-color var(--dur) var(--ease), background var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .gate__langs a:hover {
    border-color: var(--navy);
    background: var(--sky);
  }
  .gate__langs a:active {
    transform: translateY(1px);
  }
  .gate__lang {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 800;
  }
  .gate__eyebrow {
    grid-column: 1;
    font-size: var(--step--1);
    color: var(--muted);
  }
  .gate__langs :global(.icon) {
    grid-column: 2;
    grid-row: 1 / span 2;
    color: var(--red);
  }
  /* The browser's own language, marked after load. Never a redirect: a hint only. */
  .gate__langs .is-suggested a {
    border-color: var(--navy);
    box-shadow: inset 0 0 0 1px var(--navy);
  }
  .gate__facts {
    list-style: none;
    margin: 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    display: grid;
    gap: 0.7rem;
    text-align: left;
    font-size: var(--step--1);
  }
  .gate__facts li {
    display: grid;
    grid-template-columns: 1.25rem 1fr;
    gap: 0.6rem;
    align-items: start;
  }
  .gate__facts :global(.icon) {
    margin-top: 0.15rem;
    color: var(--muted);
  }
  .gate__facts a {
    color: var(--ink);
    overflow-wrap: anywhere;
  }
</style>
