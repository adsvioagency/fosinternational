---
import '../styles/global.css';
import { Image } from 'astro:assets';
import emblem from '../assets/photos/logo-emblem.png';
import { business } from '../config/business';
import { langs } from '../content/types';
import { pathFor } from '../i18n/routes';
import { ui } from '../i18n/ui';
---

<!doctype html>
<html lang="fr" translate="no">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{langs.map((l) => ui[l].notFound.title).join(' · ')} | {business.name}</title>
    <meta name="robots" content="noindex" />
    <meta name="google" content="notranslate" />
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body>
    <main class="nf container">
      <a href={pathFor('home', 'fr')} class="nf__brand" aria-label={business.name}>
        <Image src={emblem} alt="" width={56} height={Math.round((56 * emblem.height) / emblem.width)} densities={[2, 3]} />
      </a>
      <div class="nf__cols">
        {
          langs.map((l, i) => (
            <section lang={l}>
              <p class="eyebrow">404</p>
              {i === 0 ? <h1 class="nf__h">{ui[l].notFound.title}</h1> : <h2 class="nf__h">{ui[l].notFound.title}</h2>}
              <p>{ui[l].notFound.text}</p>
              <p class="btn-row">
                <a class="btn btn--primary" href={pathFor('home', l)}>{ui[l].notFound.home}</a>
                <a class="btn btn--secondary" href={pathFor('services', l)}>{ui[l].nav.services}</a>
              </p>
            </section>
          ))
        }
      </div>
      <p class="nf__contact">
        <a href={business.phone.tel}>{business.phone.display}</a> · <a href={business.whatsapp.base}>WhatsApp</a>
      </p>
    </main>
  </body>
</html>

<style>
  body {
    padding-bottom: 0;
    background: var(--warm);
  }
  .nf {
    min-height: 100dvh;
    display: grid;
    align-content: center;
    gap: 2rem;
    padding-block: 3rem;
  }
  .nf__cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
  }
  .nf__h {
    font-size: var(--step-3);
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  .nf__contact {
    color: var(--muted);
  }
  @media (max-width: 899px) {
    .nf__cols {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
