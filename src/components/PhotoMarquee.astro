---
// Continuously scrolling strip of client photos with a pause control (WCAG 2.2.2), pause on
// hover/focus, and a larger view on click. With reduced motion (or no JS) it becomes a
// manually scrollable row. The second copy of the strip exists only for the seamless loop
// and is hidden from assistive technology.
import { getImage } from 'astro:assets';
import Icon from './Icon.astro';
import type { Lang } from '../content/types';
import type { ClientPhoto } from '../content/social-proof';
import { ui } from '../i18n/ui';

interface Props {
  photos: ClientPhoto[];
  lang: Lang;
  label: string;
}
const { photos, lang, label } = Astro.props;
const H = 360;
const items = await Promise.all(
  photos.map(async (p) => {
    const ratio = Math.min(1.45, Math.max(0.62, p.image.width / p.image.height));
    const w = Math.round(H * ratio);
    const thumb = await getImage({ src: p.image, width: w * 2, format: 'webp' });
    const large = await getImage({ src: p.image, width: Math.min(1400, p.image.width), format: 'webp' });
    return { ...p, w, thumb: thumb.src, large: large.src };
  })
);
const t = ui[lang].photos;
const duration = Math.max(40, photos.length * 7);
---

<div class="marquee" data-marquee style={`--duration: ${duration}s`} role="region" aria-label={label}>
  <div class="marquee__viewport" tabindex="0" aria-label={label}>
    <div class="marquee__track" data-track>
      {
        [0, 1].map((copy) => (
          <ul class="marquee__list" role="list" aria-hidden={copy === 1 ? 'true' : undefined} data-copy={copy}>
            {items.map((p) => (
              <li class="marquee__item" style={`--w: ${p.w}px`}>
                <button
                  type="button"
                  class="marquee__btn"
                  data-open={p.large}
                  data-caption={p.caption[lang]}
                  data-alt={p.alt[lang]}
                  tabindex={copy === 1 ? -1 : undefined}
                  aria-label={copy === 1 ? undefined : `${t.open}${ui[lang].sep}${p.caption[lang]}`}
                >
                  <img src={p.thumb} alt={copy === 1 ? '' : p.alt[lang]} width={p.w} height={H} loading={copy === 0 ? 'eager' : 'lazy'} decoding="async" />
                  <span class="marquee__caption">{p.caption[lang]}</span>
                </button>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
  <button type="button" class="marquee__toggle" data-toggle data-label-pause={t.pause} data-label-play={t.play} aria-pressed="false">
    <span class="marquee__toggle-pause" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 16 16"><rect x="3" y="2" width="3.5" height="12" rx="1" fill="currentColor"></rect><rect x="9.5" y="2" width="3.5" height="12" rx="1" fill="currentColor"></rect></svg></span>
    <span class="marquee__toggle-play" aria-hidden="true"><Icon name="play" size={16} /></span>
    <span class="visually-hidden" data-toggle-label>{t.pause}</span>
  </button>
</div>

<dialog class="lightbox" data-lightbox aria-label={label}>
  <button type="button" class="lightbox__close" data-close aria-label={t.close}><Icon name="x" size={22} /></button>
  <figure>
    <img data-lightbox-img alt="" />
    <figcaption data-lightbox-caption></figcaption>
  </figure>
</dialog>

<style>
  .marquee {
    position: relative;
    margin-top: 1.5rem;
  }
  .marquee__viewport {
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent 0, #000 4%, #000 96%, transparent 100%);
    border-radius: var(--radius-lg);
  }
  .marquee__viewport:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 4px;
  }
  .marquee__track {
    display: flex;
    width: max-content;
  }
  .marquee__list {
    list-style: none;
    margin: 0;
    padding: 0 0.5rem 0 0;
    display: flex;
    gap: 1rem;
    padding-right: 1rem;
  }
  .marquee__item {
    flex: none;
    width: var(--w);
  }
  .marquee__btn {
    position: relative;
    display: block;
    width: 100%;
    height: 360px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    cursor: zoom-in;
    background: var(--sky);
  }
  .marquee__btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms var(--ease);
  }
  .marquee__btn:hover img {
    transform: scale(1.04);
  }
  .marquee__btn:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: -3px;
  }
  .marquee__caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 2.5rem 1rem 0.85rem;
    background: linear-gradient(180deg, transparent, rgb(0 26 61 / 0.82));
    color: var(--white);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    text-align: left;
  }
  .marquee__toggle {
    position: absolute;
    right: 0.85rem;
    top: 0.85rem;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 0;
    background: rgb(255 255 255 / 0.95);
    color: var(--navy);
    box-shadow: var(--shadow);
    cursor: pointer;
  }
  .marquee__toggle-play,
  .marquee.is-paused .marquee__toggle-pause {
    display: none;
  }
  .marquee.is-paused .marquee__toggle-play {
    display: grid;
  }

  /* Motion: only with JavaScript and when the visitor has not asked for reduced motion. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .marquee__track {
      animation: marquee var(--duration) linear infinite;
    }
    :global(.js) .marquee:hover .marquee__track,
    :global(.js) .marquee:focus-within .marquee__track,
    :global(.js) .marquee.is-paused .marquee__track {
      animation-play-state: paused;
    }
    @keyframes marquee {
      to {
        transform: translateX(-50%);
      }
    }
  }
  /* Static fallback: a scrollable row without the duplicate copy. */
  @media (prefers-reduced-motion: reduce) {
    .marquee__viewport {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      mask-image: none;
    }
    .marquee__item {
      scroll-snap-align: start;
    }
    .marquee__list[data-copy='1'],
    .marquee__toggle {
      display: none;
    }
  }
  :global(.no-js) .marquee__viewport {
    overflow-x: auto;
    mask-image: none;
  }
  :global(.no-js) .marquee__list[data-copy='1'],
  :global(.no-js) .marquee__toggle {
    display: none;
  }
  @media (max-width: 599px) {
    .marquee__item {
      width: calc(var(--w) * 0.72);
    }
    .marquee__btn {
      height: 260px;
    }
  }

  .lightbox {
    max-width: min(92vw, 1100px);
    max-height: 92dvh;
    padding: 0;
    border: 0;
    border-radius: var(--radius-lg);
    background: var(--navy-950);
    overflow: hidden;
  }
  .lightbox::backdrop {
    background: rgb(0 26 61 / 0.82);
  }
  .lightbox figure {
    margin: 0;
  }
  .lightbox img {
    display: block;
    max-width: 100%;
    max-height: calc(92dvh - 3.5rem);
    margin: 0 auto;
    object-fit: contain;
  }
  .lightbox figcaption {
    color: var(--white);
    padding: 0.85rem 1.25rem;
    font-weight: 600;
  }
  .lightbox__close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 0;
    background: rgb(255 255 255 / 0.95);
    color: var(--navy);
    cursor: pointer;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-marquee]').forEach((root) => {
    const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]')!;
    const label = root.querySelector<HTMLElement>('[data-toggle-label]')!;
    toggle.addEventListener('click', () => {
      const paused = root.classList.toggle('is-paused');
      toggle.setAttribute('aria-pressed', String(paused));
      label.textContent = (paused ? toggle.dataset.labelPlay : toggle.dataset.labelPause) ?? '';
    });
  });

  const box = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  if (box && typeof box.showModal === 'function') {
    const img = box.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
    const cap = box.querySelector<HTMLElement>('[data-lightbox-caption]')!;
    let opener: HTMLElement | null = null;
    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-open]');
      if (!btn) return;
      opener = btn;
      img.src = btn.dataset.open!;
      img.alt = btn.dataset.alt ?? '';
      cap.textContent = btn.dataset.caption ?? '';
      box.showModal();
    });
    box.querySelector('[data-close]')?.addEventListener('click', () => box.close());
    box.addEventListener('click', (e) => {
      if (e.target === box) box.close();
    });
    box.addEventListener('close', () => opener?.focus());
  }
</script>
