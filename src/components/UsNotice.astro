---
import Icon from './Icon.astro';
import type { Lang } from '../content/types';
import { src } from '../content/sources';
import { t, typo } from '../i18n/ui';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const n = t(lang).notice;
---

<aside class="notice" aria-labelledby={`notice-${lang}`}>
  <Icon name="info" size={22} class="notice__icon" />
  <div>
    <p class="notice__title" id={`notice-${lang}`}>{n.title}</p>
    <p>{typo(n.text, lang)}</p>
    <p class="notice__meta">
      <a href={src.dosSuspension.url} target="_blank" rel="noopener">{n.link}<span class="visually-hidden"> {t(lang).videos.external}</span></a>
      <span>{n.checked}</span>
    </p>
  </div>
</aside>

<style>
  .notice {
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    gap: 0.85rem;
    background: var(--white);
    border: 1px solid var(--border);
    border-left: 4px solid var(--navy);
    border-radius: var(--radius);
    padding: 1.25rem 1.5rem;
  }
  .notice :global(.notice__icon) {
    color: var(--navy);
    margin-top: 0.15rem;
  }
  .notice__title {
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--navy);
    margin: 0 0 0.35rem;
  }
  .notice p:not(.notice__title) {
    margin: 0 0 0.6rem;
  }
  .notice__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    font-size: 0.925rem;
    color: var(--muted);
    margin: 0 !important;
  }
</style>
