---
import Icon from './Icon.astro';
import type { Lang, Testimonial } from '../content/types';
import { t, typo } from '../i18n/ui';
interface Props {
  item: Testimonial;
  lang: Lang;
  showOriginal?: boolean;
}
const { item, lang, showOriginal = true } = Astro.props;
const d = t(lang).testimonials;
---

<figure class="quote">
  <Icon name="quote" size={28} class="quote__mark" />
  <blockquote>
    <p>{typo(item.translation[lang], lang)}</p>
  </blockquote>
  <figcaption>
    <span class="quote__source">{item.attribution[lang]}</span>
    <span class="quote__note">{d.translationNote}</span>
  </figcaption>
  {
    showOriginal && (
      <details class="quote__original">
        <summary>{d.original}</summary>
        <p lang="ht">{item.original}</p>
      </details>
    )
  }
</figure>

<style>
  .quote {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.6rem;
    height: 100%;
  }
  .quote :global(.quote__mark) {
    color: var(--red);
  }
  blockquote {
    margin: 0;
    flex: 1;
  }
  blockquote p {
    font-size: 1.1rem;
    line-height: 1.55;
    color: var(--ink);
    margin: 0;
  }
  figcaption {
    display: grid;
    gap: 0.15rem;
    border-top: 1px solid var(--border);
    padding-top: 0.9rem;
  }
  .quote__source {
    font-weight: 700;
    color: var(--navy);
  }
  .quote__note {
    font-size: 0.875rem;
    color: var(--muted);
  }
  .quote__original summary {
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--navy);
    min-height: 44px;
    display: flex;
    align-items: center;
  }
  .quote__original p {
    font-size: 0.95rem;
    color: var(--muted);
    font-style: italic;
    margin: 0.25rem 0 0;
  }
</style>
