---
// "Comment nous contacter" — the three-step explanation with an illustrative message preview.
import Icon from './Icon.astro';
import { business } from '../config/business';
import type { Lang } from '../content/types';
import { contactPath } from '../i18n/routes';
import { t } from '../i18n/ui';
import { messageCopy } from '../lib/whatsapp';

interface Props {
  lang: Lang;
  headingId?: string;
}
const { lang, headingId = 'contact-steps-title' } = Astro.props;
const d = t(lang);
const s = d.steps;
const icons = ['user', 'message', 'clock'] as const;
const sep = d.sep;
const m = messageCopy[lang];
---

<section class="section section--cool steps" aria-labelledby={headingId}>
  <div class="container steps__grid">
    <div class="steps__text">
      <h2 id={headingId}>{s.title}</h2>
      <p class="lead">{s.lead}</p>
      <ol class="steps__list">
        {
          s.items.map((item, i) => (
            <li class="step" data-reveal>
              <span class="step__marker" aria-hidden="true">
                <Icon name={icons[i]} size={20} />
              </span>
              <div>
                <h3 class="step__title">
                  <span class="visually-hidden">{i + 1}. </span>
                  {item.title}
                </h3>
                <p>{item.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="steps__note">
        <Icon name="info" size={20} />
        <span>{s.note}</span>
      </p>
      <p class="steps__messaging">{d.messaging}</p>
      <div class="btn-row">
        <a class="btn btn--primary" href={contactPath(lang)} data-inquiry>{d.cta.consult}</a>
        <a class="btn btn--secondary" href={business.phone.tel}>
          <Icon name="phone" size={18} />
          {business.phone.display}
        </a>
      </div>
    </div>

    <figure class="phone" aria-label={s.previewAria}>
      <div class="phone__frame">
        <div class="phone__bar">
          <span class="phone__avatar" aria-hidden="true">F</span>
          <span class="phone__who">{business.name}</span>
        </div>
        <div class="phone__chat">
          <p class="phone__bubble">
            {m.greeting}
            <br /><br />
            <strong>{m.name}{sep}</strong>{s.previewName}<br />
            <strong>{m.phone}{sep}</strong>+1 809 000 0000<br />
            <strong>{m.service}{sep}</strong>{s.previewService}<br />
            <strong>{m.message}{sep}</strong>{s.previewMessage}
          </p>
        </div>
      </div>
      <figcaption class="phone__label">
        <Icon name="info" size={16} />
        {s.previewLabel}
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .steps__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.85fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
  }
  .steps__list {
    list-style: none;
    padding: 0;
    margin: 2rem 0 1.5rem;
    display: grid;
    gap: 0;
    position: relative;
  }
  /* The dashed route connecting the three steps echoes the logo's flight path. */
  .steps__list::before {
    content: '';
    position: absolute;
    left: 21px;
    top: 24px;
    bottom: 40px;
    border-left: 2px dashed rgb(193 20 24 / 0.55);
  }
  .step {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 1rem;
    padding-bottom: 1.5rem;
    position: relative;
  }
  .step__marker {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--navy);
    color: var(--white);
    box-shadow: 0 0 0 6px var(--sky);
  }
  .step__title {
    margin: 0.45rem 0 0.35rem;
  }
  .step p {
    margin: 0;
    color: var(--ink);
  }
  .steps__note {
    display: grid;
    grid-template-columns: 1.25rem 1fr;
    gap: 0.75rem;
    background: var(--white);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    border-left: 3px solid var(--red);
    margin: 0 0 1rem;
  }
  .steps__note :global(.icon) {
    color: var(--navy);
    margin-top: 0.15rem;
  }
  .steps__messaging {
    color: var(--muted);
    font-size: 0.975rem;
    margin-bottom: 1.5rem;
  }

  .phone {
    margin: 0;
    justify-self: center;
    width: min(100%, 340px);
  }
  .phone__frame {
    border-radius: 36px;
    background: var(--navy-950);
    padding: 12px;
    box-shadow: var(--shadow-lg);
  }
  .phone__bar {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    background: #0e2d52;
    color: var(--white);
    padding: 0.85rem 1rem;
    border-radius: 26px 26px 0 0;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .phone__avatar {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--white);
    color: var(--navy);
    font-family: var(--font-display);
    font-weight: 800;
  }
  .phone__chat {
    background: #efe9e1;
    min-height: 360px;
    padding: 1.25rem 0.9rem 1.5rem;
    border-radius: 0 0 26px 26px;
    display: flex;
    align-items: flex-end;
  }
  .phone__bubble {
    margin: 0 0 0 auto;
    max-width: 92%;
    background: #d9fdd3;
    color: #12301b;
    border-radius: 12px 12px 4px 12px;
    padding: 0.8rem 0.9rem;
    font-size: 0.9rem;
    line-height: 1.45;
    box-shadow: 0 1px 1px rgb(0 0 0 / 0.08);
  }
  .phone__label {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    margin-top: 0.85rem;
    font-size: 0.875rem;
    color: var(--muted);
  }
  @media (max-width: 899px) {
    .steps__grid {
      grid-template-columns: 1fr;
    }
    .phone__chat {
      min-height: 0;
    }
  }
</style>
