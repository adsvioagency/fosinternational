---
// Privacy policy and legal information. Both describe the site as actually implemented:
// static pages, no advertising cookies, no analytics, no server-side form storage, WhatsApp handoff,
// and one technical language cookie (nf_lang) set only when the visitor picks a language.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { business, addressLine } from '../config/business';
import type { Lang } from '../content/types';
import { pathFor } from '../i18n/routes';
import { t, typo, formatDate } from '../i18n/ui';

interface Props {
  lang: Lang;
  kind: 'privacy' | 'legal';
}
const { lang, kind } = Astro.props;
const d = t(lang);
const updated = '2026-10-27';
const label = kind === 'privacy' ? d.footer.privacy : d.footer.legal;
const crumbs = [
  { name: d.breadcrumbHome, path: pathFor('home', lang) },
  { name: label, path: pathFor(kind, lang) },
];

type Block = { h: string; p: string[] };
const email = business.email;

const privacy: Record<Lang, { title: string; description: string; blocks: Block[] }> = {
  fr: {
    title: 'Politique de confidentialité',
    description: 'Comment le site de Fernando OMG Services (FOS) traite vos informations : formulaire préparant un message WhatsApp, sans cookies publicitaires ni suivi.',
    blocks: [
      {
        h: 'En résumé',
        p: [
          'Ce site ne crée pas de compte, n’utilise pas de cookies publicitaires et n’intègre pas d’outil de mesure d’audience. Le formulaire de contact ne transmet rien à nos serveurs : il prépare un message que vous choisissez d’envoyer vous-même depuis WhatsApp.',
        ],
      },
      {
        h: 'Le formulaire de demande',
        p: [
          'Les informations que vous saisissez (prénom, nom, numéro de téléphone, service, message et préférence) restent dans votre navigateur pendant que la page est ouverte. Elles ne sont ni enregistrées sur le site, ni stockées dans votre navigateur après fermeture de la page.',
          'Lorsque vous appuyez sur « Continuer sur WhatsApp », ces informations sont placées dans un message préparé et WhatsApp s’ouvre. Si vous envoyez ce message, l’équipe de Fernando OMG Services (FOS) le reçoit sur WhatsApp. WhatsApp est un service tiers, exploité par WhatsApp/Meta, qui applique sa propre politique de confidentialité.',
          'Nous vous demandons de ne pas transmettre de documents d’identité, de numéros de dossier ou d’informations financières lors du premier contact.',
        ],
      },
      {
        h: 'Utilisation de vos informations par l’équipe',
        p: [
          'Les messages reçus servent uniquement à répondre à votre demande, à organiser une consultation et à assurer le suivi de vos démarches. Ils ne sont pas vendus ni utilisés à des fins publicitaires.',
        ],
      },
      {
        h: 'Votre langue',
        p: [
          'Lorsque vous arrivez sur l’adresse principale du site, la version française, anglaise ou espagnole s’affiche selon la langue de votre navigateur. Si vous choisissez une langue avec le sélecteur, ce choix est enregistré dans un petit cookie technique (nf_lang) pendant un an, uniquement pour vous afficher la bonne version. Il ne contient aucune information personnelle.',
          'Le navigateur peut aussi retenir, le temps de votre visite, que vous avez fermé une suggestion de langue ou le message d’aide WhatsApp.',
        ],
      },
      {
        h: 'Appels, e-mails et liens externes',
        p: [
          'Si vous nous appelez ou nous écrivez par e-mail, nous recevons les informations que vous choisissez de partager. Les liens vers TikTok, Facebook, YouTube, Google Maps ou des sites officiels ouvrent des services tiers, soumis à leurs propres règles.',
        ],
      },
      {
        h: 'Carte et vidéos intégrées',
        p: [
          'La carte de l’adresse du bureau est fournie par Google Maps : elle se charge depuis les serveurs de Google lorsque cette partie de la page s’affiche, et Google peut alors recevoir des données techniques (adresse IP, navigateur) et utiliser ses propres cookies.',
          'Les vidéos affichent une image enregistrée sur notre site. Le lecteur TikTok ne se charge que si vous appuyez sur « Lire la vidéo ici » ; TikTok applique alors ses propres règles de confidentialité.',
        ],
