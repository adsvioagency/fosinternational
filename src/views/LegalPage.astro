const page = (kind === 'privacy' ? privacy : legal)[lang];
---

<Base lang={lang} pageId={kind} title={page.title} description={page.description} crumbs={crumbs}>
  <PageHero crumbs={crumbs} crumbLabel={d.breadcrumbAria} title={page.title} />
  <div class="container section">
    <div class="prose">
      {
        page.blocks.map((b) => (
          <section>
            <h2>{b.h}</h2>
            {b.p.map((p) => <p>{typo(p, lang)}</p>)}
          </section>
        ))
      }
      <p class="updated">{d.updated}{d.sep}<time datetime={updated}>{formatDate(updated, lang)}</time></p>
    </div>
  </div>
</Base>

<style>
  .prose section:first-child h2 {
    margin-top: 0;
  }
  .updated {
    color: var(--muted);
    font-size: 0.9rem;
    border-top: 1px solid var(--border);
    padding-top: 1rem;
    margin-top: 2rem;
  }
</style>
